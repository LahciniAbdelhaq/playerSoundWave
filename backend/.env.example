# ---- Server ----
PORT=4000
NODE_ENV=development
# Vercel: https://<your-frontend>.vercel.app
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
# Local dev: SQLite, zero setup (`npm run start:dev` runs `npm run db:local` first).
DATABASE_URL="file:./dev.db"
# Vercel: added automatically when you connect a Neon Postgres database:
# DATABASE_URL=postgresql://...-pooler...      (pooled, used by the app)
# DATABASE_URL_UNPOOLED=postgresql://...       (direct, used by `prisma db push`)

# ---- JWT ---- (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

# ---- Storage ----
# local (files on disk) | blob (Vercel Blob; needs BLOB_READ_WRITE_TOKEN, which
# Vercel adds automatically when you connect a Blob store)
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
PUBLIC_MEDIA_URL=http://localhost:4000/media

# ---- Media tools ----
# Leave unset on Vercel: ffmpeg comes from ffmpeg-static, yt-dlp from bin/.
# Local Windows dev points these at the binaries in .tools/.
# FFMPEG_PATH=
# YTDLP_PATH=
MAX_UPLOAD_MB=50

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=120
